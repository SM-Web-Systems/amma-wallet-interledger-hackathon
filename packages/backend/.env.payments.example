# Merge into an ISOLATED backend configuration, alongside existing JWT/DB/SSO settings.
PAYMENTS_ENABLED=false
PAYMENTS_PAUSED=true
PAYMENTS_LIVE_VERIFIED=false
PAYMENTS_MAX_RECEIVE_UNITS=10000000000
PAYMENTS_DAILY_MAX_UNITS=100000000000
# Scan Rafiki for payments whose webhooks were lost (queues only; the worker still reads authoritative state).
PAYMENTS_CATCHUP_INTERVAL_MS=300000
PAYMENTS_CATCHUP_LOOKBACK_MS=604800000
PAYMENTS_WALLET_ADDRESS_BASE=https://pay-a.stage.example/
PAYMENTS_STELLAR_TREASURY=
# JSON entries: {"asset":{"chain":"stellar","network":"testnet","code":"ZARC","issuer":"VERIFIED_TEST_ISSUER","scale":7},"assetId":"RAFIKI_ASSET_UUID","senderId":"TREASURY_ADDRESS_UUID","senderUrl":"https://pay-a.stage.example/treasury/zarc"}
PAYMENTS_RAFIKI_ASSETS=[]
RAFIKI_ADMIN_URL=http://127.0.0.1:13001/graphql
RAFIKI_AUTH_ADMIN_URL=http://127.0.0.1:13003/graphql
RAFIKI_INTERACTION_URL=http://127.0.0.1:13009
# Production: RAFIKI_INTERACTION_URL, RAFIKI_ADMIN_URL and RAFIKI_AUTH_ADMIN_URL must be https, or an in-network Docker service listed here
# (single-label names only, comma-separated), e.g. RAFIKI_INTERACTION_URL=http://auth-a:3009 with:
PAYMENTS_INTERNAL_HOSTS=
RAFIKI_AUTH_URL=https://auth-a.stage.example
RAFIKI_TENANT_ID=
RAFIKI_ADMIN_SECRET=
RAFIKI_IDP_SECRET=
RAFIKI_WEBHOOK_SECRET=
OPEN_PAYMENTS_CLIENT_ADDRESS=https://pay-a.stage.example/client
OPEN_PAYMENTS_KEY_ID=
OPEN_PAYMENTS_PRIVATE_KEY_FILE=
OPEN_PAYMENTS_ALLOWED_ORIGINS=https://pay-a.stage.example,https://pay-b.stage.example,https://auth-a.stage.example,https://auth-b.stage.example
# This is an operator-maintained Amma gateway, not a vendor's public API URL.
PAYMENTS_PARTNER_GATEWAY=
PAYMENTS_PARTNER=fivewest
PAYMENTS_PARTNER_TOKEN=
PAYMENTS_PARTNER_VERIFIED=false
