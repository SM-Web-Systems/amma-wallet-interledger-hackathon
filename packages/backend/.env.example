# Copy to packages/backend/.env for local development.
# NEVER commit .env — it is gitignored.
# Production secrets are managed in amma-wallet-docker/app.env (not in this repo).

# --- App ---
NODE_ENV=development
PORT=3001

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://stellarwallet:changeme@localhost:5432/stellarwallet

# --- JWT (end-user sessions) ---
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token TTL in seconds (default: 900 = 15 min access, 604800 = 7 days refresh)
JWT_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# --- Admin JWT (internal admin panel — separate from user tokens) ---
# Generate with: openssl rand -hex 64
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=3600

# --- Stellar / Horizon ---
# "public" for mainnet, "testnet" for staging
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Soroban RPC per network for NFT reads. A collection is read on its own network; these override the defaults
# (mainnet: https://mainnet.sorobanrpc.com, testnet: https://soroban-testnet.stellar.org).
# SOROBAN_RPC_URL_PUBLIC=
# SOROBAN_RPC_URL_TESTNET=
# SEP-50 contracts listed in every owner's wallet, as CONTRACTID@public or CONTRACTID@testnet, comma separated.
# Set this to the LMS certificate contract so certificates show without any manual registration.
# NFT_KNOWN_SEP50_CONTRACTS=

# --- Platform wallet (Stellar keypair) ---
# The platform operations wallet that pays activation fees
# Public key (G...) — shown in UI and stellar.toml
PLATFORM_WALLET=
# Secret key (S...) — NEVER log, print, or commit
PLATFORM_SECRET=

# --- Signing keypair (Stellar SEP-0010 challenge signing) ---
SIGNING_PUBLIC_KEY=
# Secret key — NEVER log, print, or commit
SIGNING_SECRET_KEY=

# --- Cloudflare Turnstile ---
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# --- API keys (comma-separated) ---
# Server-to-server keys for integrations (e.g. LMS → wallet)
# Must match AMMA_WALLET_API_KEY in LMS .env
API_KEYS=

# --- SSO (Amma Wallet acts as Identity Provider for LMS) ---
# Shared secret — must match AMMA_SSO_STATE_SECRET in LMS .env
SSO_SECRET=
# Comma-separated allowed callback URL prefixes
SSO_CALLBACK_WHITELIST=https://lms.smwebsystems.com
# WA-05 (SSO audience binding). DEFAULT IS SAFE: with SSO_AUDIENCE_ENFORCE unset, SSO behaves as before and an origins-only whitelist still works.
# Cutover (owner go + LMS AUTH-14, same release as the whitelist change): set SSO_AUDIENCE_ENFORCE=true, make each whitelist entry origin=tenantId,
# and set the three window variables below. See the WA-05 spec section 6.
SSO_AUDIENCE_ENFORCE=
# Only read when enforcing. ISO date after which the old "lms-amma-sso" audience is refused (empty = refused now), and the LMS tenant id.
SSO_LEGACY_AUD_UNTIL=
SSO_LEGACY_AUD_TENANT_ID=
# Only read when enforcing. D1 option B: ISO date (at most 14 days after cutover) until which an env API key may verify as the LMS tenant. Empty = refused.
SSO_ENV_KEY_UNTIL=

# --- SMTP ---
SMTP_HOST=mail.smwebsystems.com
SMTP_PORT=587
SMTP_USER=noreply.smwebsystems
# App password or SMTP credential — NEVER commit
SMTP_PASS=
SMTP_FROM=Amma Wallet <noreply@ammawallet.com>

# --- Web app URLs (for CORS and redirect generation) ---
WEB_APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001

# --- VAPID (web push notifications — optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Optional: Stripe Crypto Onramp ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_ONRAMP_ENABLED=false

# --- Optional: Transak ---
TRANSAK_API_KEY=
TRANSAK_ENVIRONMENT=STAGING
TRANSAK_ENABLED=false

# XRP wallet reads/onboarding and payments are separately opt-in (Testnet only).
XRPL_ENABLED=false
XRPL_NETWORK=testnet
XRPL_PAYMENTS_ENABLED=false
XRPL_RECONCILIATION_ENABLED=false
XRPL_RECONCILIATION_INTERVAL_MS=15000
XRPL_RECONCILIATION_BATCH_SIZE=10

# External application intents/status/claims; requires both XRP flags above.
XRPL_INTEGRATION_ENABLED=false

# Required operator-owned read-only JSON mount for admission/broadcast.
# Missing/invalid control file pauses submission even if payments are enabled.
# Format: {"schemaVersion":1,"paused":true}. Atomic host replacement to change.
XRPL_SUBMISSION_CONTROL_FILE=/run/amma/xrpl-control.json
XRPL_MONITORING_ENABLED=false
XRPL_MONITORING_INTERVAL_MS=60000
XRPL_PENDING_ALERT_SECONDS=300
