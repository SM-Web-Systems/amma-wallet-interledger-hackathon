{
  "expo": {
    "name": "Amma Wallet",
    "slug": "amma-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ammawallet",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon-128.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c1110"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ammawallet.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-128.png",
        "backgroundColor": "#0c1110"
      },
      "package": "com.ammawallet.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-local-authentication",
      "react-native-quick-crypto"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "204fcd81-27b1-4e30-b126-12a9ea6af5ba"
      }
    },
    "owner": "sm-web-systems"
  }
}
