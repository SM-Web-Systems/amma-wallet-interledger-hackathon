# Copy to ignored .env. Supply real staging HTTPS names and distinct random values.
# Database passwords must be URL-safe. Secrets must be at least 32 random bytes.
PEER_A_DATABASE_PASSWORD=
PEER_B_DATABASE_PASSWORD=
PEER_A_TENANT_ID=
PEER_B_TENANT_ID=
PEER_A_ADMIN_SECRET=
PEER_B_ADMIN_SECRET=
PEER_A_IDP_SECRET=
PEER_B_IDP_SECRET=
PEER_A_WEBHOOK_SECRET=
PEER_B_WEBHOOK_SECRET=
PEER_A_COOKIE_KEY=
PEER_B_COOKIE_KEY=
PEER_A_STREAM_SECRET=
PEER_B_STREAM_SECRET=
PEER_A_KEY_ID=amma-peer-a
PEER_B_KEY_ID=amma-peer-b
PEER_A_RESOURCE_URL=https://pay-a.stage.example
PEER_B_RESOURCE_URL=https://pay-b.stage.example
PEER_A_AUTH_URL=https://auth-a.stage.example
PEER_B_AUTH_URL=https://auth-b.stage.example
# Amma's client/sender wallet on each peer, created by provision-peers.ts. It must
# differ from the Rafiki instance address <RESOURCE_URL>/.well-known/pay, which
# Rafiki hides. Rafiki rejects non-https wallet addresses: on a single machine use
# compose.local-tls.yml with the *.amma.test names listed in that file.
PEER_A_CLIENT_ADDRESS=https://pay-a.stage.example/client
PEER_B_CLIENT_ADDRESS=https://pay-b.stage.example/client
PEER_A_WEBHOOK_URL=https://amma-a.stage.example/api/v1/payments/webhooks/rafiki
PEER_B_WEBHOOK_URL=https://amma-b.stage.example/api/v1/payments/webhooks/rafiki
AMMA_CONSENT_URL=https://amma-a.stage.example/payments/consent
PEER_B_CONSENT_URL=https://amma-b.stage.example/payments/consent

# The provisioning CLI uses these additional private endpoints and paths.
PEER_A_ADMIN_URL=http://127.0.0.1:13001/graphql
PEER_B_ADMIN_URL=http://127.0.0.1:23001/graphql
PEER_A_PRIVATE_KEY_FILE=../../docker/interledger/secrets/peer-a.pem
PEER_B_PRIVATE_KEY_FILE=../../docker/interledger/secrets/peer-b.pem
PEERING_TEST_TOKEN=
