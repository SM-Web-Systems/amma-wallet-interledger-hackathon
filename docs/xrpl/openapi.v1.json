{
  "openapi": "3.1.0",
  "info": {
    "title": "Amma XRP Testnet integration",
    "version": "1.0.0",
    "description": "Release A native XRP, explicit browser approval only. External operations require BOTH the payer's short-lived personal JWT and an active database tenant key with the exact scope, active unsuspended tenant and tenant_users membership. One tenant is one application boundary; rotating keys retain access. No env keys, wildcard scopes or DB-outage fallback. Keep keys server-side. An API key never authorizes prepare/submit/rebroadcast/cancel. Existing first-party personal JWT routes also serve owners without an API key. External status omits unsigned preparation and receipt; fetch the receipt separately. Pending/timeout is never settlement. Rate limits are per process; deployment must enforce shared limits before scaling."
  },
  "servers": [
    {
      "url": "/",
      "description": "Use the operator-configured trusted Testnet API origin."
    }
  ],
  "security": [
    {
      "UserSession": [],
      "ApplicationKey": []
    }
  ],
  "paths": {
