            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "HTTP 413; inspect error.code and retryable. Unavailability never proves non-payment.",
            "content": {
              "application/json": {
