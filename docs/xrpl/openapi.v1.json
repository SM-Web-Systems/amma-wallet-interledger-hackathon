  "components": {
    "securitySchemes": {
      "UserSession": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Personal user access JWT obtained by the existing Amma authentication flow. Admin, refresh and SSO token types rejected."
      },
      "ApplicationKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "DB-backed tenant key with the operation's exact x-required-application-scope."
      }
    },
    "schemas": {
      "PaymentInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "chain": {
            "const": "xrpl"
          },
          "network": {
            "const": "testnet"
          },
          "walletId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,14}$"
          },
          "destination": {
            "type": "string",
            "minLength": 25,
            "maxLength": 35,
            "description": "Checksum-valid classic XRPL address; X-addresses rejected."
          },
          "destinationTag": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "amountDrops": {
            "type": "string",
            "pattern": "^(?:[1-9][0-9]{0,16}|100000000000000000)$",
            "description": "Integer drops, at most 100000000000000000; 1 XRP = 1000000 drops."
          },
          "maxFeeDrops": {
            "type": "string",
            "pattern": "^(?:[1-9][0-9]{0,2}|1000)$",
            "description": "1 to 1000 drops, capped by server policy."
          },
          "reference": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "schemaVersion",
          "chain",
          "network",
          "walletId",
          "destination",
          "amountDrops",
          "maxFeeDrops",
          "reference"
        ]
      },
      "PaymentStatus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "chain": {
            "const": "xrpl"
          },
          "network": {
            "const": "testnet"
          },
          "walletId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,14}$"
          },
          "destination": {
            "type": "string",
            "minLength": 25,
            "maxLength": 35,
            "description": "Checksum-valid classic XRPL address; X-addresses rejected."
          },
          "destinationTag": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "amountDrops": {
            "type": "string",
            "pattern": "^(?:[1-9][0-9]{0,16}|100000000000000000)$",
            "description": "Integer drops, at most 100000000000000000; 1 XRP = 1000000 drops."
          },
          "maxFeeDrops": {
            "type": "string",
            "pattern": "^(?:[1-9][0-9]{0,2}|1000)$",
            "description": "1 to 1000 drops, capped by server policy."
          },
          "reference": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "ownerId": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          },
          "source": {
            "type": "string",
            "minLength": 25,
            "maxLength": 35,
            "description": "Checksum-valid classic XRPL address; X-addresses rejected."
          },
          "state": {
            "enum": [
              "awaiting_approval",
              "prepared",
              "signed",
              "submitted",
              "validated_success",
              "validated_failure",
              "expired",
              "cancelled"
            ]
          },
          "transactionHash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-F0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "resultCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastObservation": {
            "type": [
              "string",
              "null"
            ]
          },
          "application": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tenantId": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "tenantId",
                  "name"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "approvalPath": {
            "type": "string",
            "pattern": "^/xrpl\\?walletId=[1-9][0-9]*&intentId=[0-9a-f-]+$",
            "description": "Append to your configured trusted Amma frontend origin. No credential or automatic approval is conveyed."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "schemaVersion",
          "chain",
          "network",
          "walletId",
          "destination",
          "amountDrops",
          "maxFeeDrops",
          "reference",
          "id",
          "ownerId",
          "source",
          "state",
          "transactionHash",
          "resultCode",
          "lastObservation",
          "application",
          "approvalPath",
          "createdAt",
          "updatedAt"
        ]
      },
      "Receipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "chain": {
            "const": "xrpl"
          },
          "network": {
            "const": "testnet"
          },
          "intentId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "transactionHash": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          },
          "ledgerIndex": {
            "type": "integer",
            "minimum": 1
          },
          "ledgerHash": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          },
          "validated": {
            "const": true
          },
          "result": {
            "const": "tesSUCCESS"
          },
          "source": {
            "type": "string",
            "minLength": 25,
            "maxLength": 35,
            "description": "Checksum-valid classic XRPL address; X-addresses rejected."
          },
          "destination": {
            "type": "string",
            "minLength": 25,
            "maxLength": 35,
            "description": "Checksum-valid classic XRPL address; X-addresses rejected."
          },
          "destinationTag": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "currency": {
            "const": "XRP"
          },
          "deliveredAmountDrops": {
            "type": "string",
            "pattern": "^(?:[1-9][0-9]{0,16}|100000000000000000)$",
            "description": "Integer drops, at most 100000000000000000; 1 XRP = 1000000 drops."
          },
          "feeDrops": {
            "type": "string",
            "pattern": "^(?:[1-9][0-9]{0,16}|100000000000000000)$",
            "description": "Integer drops, at most 100000000000000000; 1 XRP = 1000000 drops."
          },
          "reference": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "verifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "schemaVersion",
          "chain",
          "network",
          "intentId",
          "transactionHash",
          "ledgerIndex",
          "ledgerHash",
          "validated",
          "result",
          "source",
          "destination",
          "currency",
          "deliveredAmountDrops",
          "feeDrops",
          "reference",
          "verifiedAt"
        ]
      },
      "ClaimInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "reference": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "transactionHash": {
            "type": "string",
            "pattern": "^[A-F0-9]{64}$"
          },
          "purchaseId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "schemaVersion",
          "reference",
          "transactionHash",
          "purchaseId"
        ]
      },
      "Claim": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
