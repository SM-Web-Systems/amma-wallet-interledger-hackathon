                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "HTTP 422; inspect error.code and retryable. Unavailability never proves non-payment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "HTTP 429; inspect error.code and retryable. Unavailability never proves non-payment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "HTTP 503; inspect error.code and retryable. Unavailability never proves non-payment.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Creates a request only. Open approvalPath on the trusted Amma frontend; the user must review and sign locally. Never send keys, passphrases or approved=true."
      }
    },
